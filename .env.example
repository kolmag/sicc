# SICC — Environment Variables
# Copy to .env and fill in your keys

# Anthropic — Haiku for KB enrichment at ingestion
ANTHROPIC_API_KEY=

# OpenAI — text-embedding-3-small embeddings
OPENAI_API_KEY=

# Groq — OSS-120B answer generator + HyDE rewriter, OSS-20B groundedness checker
GROQ_API_KEY=

# Langfuse — observability and tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
