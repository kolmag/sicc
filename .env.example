# Copy to .env and fill in your values

# LLM providers (used by RAG pipeline and portfolio Q&A)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Web UI auth (both REQUIRED — the app fails closed if either is unset).
# SICC_SESSION_SECRET signs the session cookie; use a long random value, e.g.
#   openssl rand -hex 32
SICC_PASSWORD=
SICC_SESSION_SECRET=
